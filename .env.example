FLASK_APP=run.py
FLASK_DEBUG=true
SECRET_KEY=replace-with-a-long-random-local-development-secret

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=moffat_bay
MYSQL_USER=moffat_app
MYSQL_PASSWORD=replace-with-your-local-password
# Local-only shortcut: MYSQL_USER=root and MYSQL_PASSWORD=${MYSQL_ROOT_PASSWORD}
# (set MYSQL_ROOT_PASSWORD in your OS environment). See docs/DEVELOPMENT.md.

# Test database setup: set MYSQL_ROOT_PASSWORD in your OS environment, then run
# python scripts/setup_databases.py. The script creates the disposable moffat_bay_test
# database and writes TEST_DATABASE_URL to your ignored .env file. Never use a
# production database for TEST_DATABASE_URL.

